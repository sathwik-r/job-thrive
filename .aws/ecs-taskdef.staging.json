{
  "family": "job-thrive-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/job-thrive-task-role",
  "containerDefinitions": [
    {
      "name": "job-thrive",
      "image": "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/job-thrive:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "5000" },
        { "name": "AWS_REGION", "value": "ap-south-1" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/job-thrive/database-url" },
        { "name": "COGNITO_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/job-thrive/cognito-client-secret" },
        { "name": "RAZORPAY_KEY_ID", "valueFrom": "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/job-thrive/razorpay-key-id" },
        { "name": "RAZORPAY_KEY_SECRET", "valueFrom": "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/job-thrive/razorpay-key-secret" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5000/healthz || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
