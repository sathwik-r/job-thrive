{
    "extends": "./tsconfig.json",
    "include": ["client/src/**/*", "shared/**/*"],
    "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
    "compilerOptions": {
      "module": "ESNext",
      "noEmit": true,
      "lib": ["esnext", "dom", "dom.iterable"],
      "jsx": "preserve",
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "types": ["vite/client"]
    }
  }