{
  "extends": "./tsconfig.json", 
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "outDir": "./dist",
    "noEmit": false,
    "moduleResolution": "Bundler", // Changed this
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "verbatimModuleSyntax": false // Add this
  }
}